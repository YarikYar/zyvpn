# Database
DB_PASSWORD=your-secure-password

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBAPP_URL=https://vpn.example.com

# Servers (XUI panels) теперь хранятся в БД таблице `servers`,
# а не в env. Здесь только адрес миниаппа и общие настройки.

# TON
TON_TESTNET=false
TON_WALLET_ADDRESS=your-ton-wallet-address

# CORS — список разрешённых Origin через запятую. Пусто = всё блокируется.
ALLOW_ORIGINS=https://vpn.example.com,https://api.example.com

# Защита /internal/cron/* — длинная случайная строка. Пусто = эндпоинты
# отключены, и любые попытки получают 503.
INTERNAL_SECRET=generate-a-long-random-string
